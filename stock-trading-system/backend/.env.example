PORT=5000

# MongoDB — local OR MongoDB Atlas (cloud). All users, trades, portfolios are stored here.
# Atlas example (replace USER, PASSWORD, CLUSTER):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tradex?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tradex

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
INITIAL_VIRTUAL_BALANCE=100000

# Live stock prices (free key: https://finnhub.io/register)
# FINNHUB_API_KEY=your_finnhub_api_key
PRICE_UPDATE_INTERVAL_MS=30000

# Seed: only adds stocks if DB is empty. Never deletes real users.
# SEED_DEMO_USERS=true
# SEED_FORCE=true
